# Where the API listens, and where its SQLite file and built frontend live.
CAL_ADDR=:8080
CAL_DB=data/cal.db
CAL_WEB=web/dist

# First admin on a fresh box. Created once, on first boot, when the user table
# is empty. Change the password before you expose the instance.
CAL_ADMIN_EMAIL=you@example.com
CAL_ADMIN_PASSWORD=change-me-please

# setup  = the first visitor creates the admin account through the UI
# invite = no signup page at all; accounts only come from an invite link
CAL_SIGNUP=setup

# 1 when the instance is behind HTTPS, so the session cookie is Secure-only.
CAL_SECURE=0

# Ingest credentials are NOT set here. They are stored per session, server-side,
# through the app, so two servers on one instance can use different stores and
# no key ever reaches the browser.
